    <path
        android:pathData="M30,38 L78,38 A6,6 0 0 1 84,44 L84,76 A6,6 0 0 1 78,82 L30,82 A6,6 0 0 1 24,76 L24,44 A6,6 0 0 1 30,38 Z"
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.95" />

    <!-- 顶部标签条 -->
    <path
        android:pathData="M30,42 L78,42 A2,2 0 0 1 80,44 L80,52 L28,52 L28,44 A2,2 0 0 1 30,42 Z"
        android:fillColor="#5E35B1" />

    <!-- 中间山形(代表照片) -->
    <path
        android:pathData="M36,72 L48,58 L58,68 L66,60 L72,66 L72,74 L36,74 Z"
        android:fillColor="#5E35B1" />

    <!-- 太阳圆 -->
